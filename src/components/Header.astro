---
import { GITHUB_PROFILE_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="header-inner" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}, home`}>
			<span class="brand-mark" aria-hidden="true"></span>
			<span>
				<strong>Stephen McCruden</strong>
				<small>Infrastructure Engineer</small>
			</span>
		</a>

		<div class="desktop-nav">
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a
				class="external-link"
				href={GITHUB_PROFILE_URL}
				target="_blank"
				rel="noreferrer"
			>
				GitHub <span aria-hidden="true">↗</span>
			</a>
		</div>

		<details class="mobile-menu">
			<summary aria-label="Open navigation">
				<span></span>
				<span></span>
				<span></span>
			</summary>
			<div class="mobile-panel">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/blog">Writing</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<a href={GITHUB_PROFILE_URL} target="_blank" rel="noreferrer">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</div>
		</details>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		z-index: 50;
		top: 0;
		border-top: 3px solid var(--color-accent-deep);
		border-bottom: 1px solid var(--color-border);
		background: rgba(13, 14, 16, 0.92);
		backdrop-filter: blur(16px);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(var(--content-width), calc(100% - 2.5rem));
		min-height: 4.4rem;
		margin-inline: auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.brand-mark {
		width: 0.6rem;
		height: 0.6rem;
		flex: 0 0 auto;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 0.28rem var(--color-accent-soft);
	}

	.brand strong,
	.brand small {
		display: block;
		line-height: 1.2;
	}

	.brand strong {
		font-size: 0.98rem;
	}

	.brand small {
		margin-top: 0.16rem;
		color: var(--color-text-subtle);
		font-size: 0.76rem;
		font-weight: 400;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 1.7rem;
	}

	.external-link {
		padding-left: 1.7rem;
		border-left: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
	}

	.external-link:hover {
		color: var(--color-accent-strong);
	}

	.mobile-menu {
		position: relative;
		display: none;
	}

	.mobile-menu summary {
		display: grid;
		width: 2.6rem;
		height: 2.6rem;
		cursor: pointer;
		list-style: none;
		place-content: center;
		gap: 0.28rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu summary span {
		display: block;
		width: 1rem;
		height: 1px;
		background: var(--color-text);
	}

	.mobile-panel {
		position: absolute;
		top: calc(100% + 0.65rem);
		right: 0;
		display: grid;
		min-width: 13rem;
		padding: 0.5rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: var(--shadow);
	}

	:global(.mobile-panel a) {
		padding: 0.75rem 0.8rem;
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
	}

	:global(.mobile-panel a:hover),
	:global(.mobile-panel a.active) {
		background: var(--color-accent-soft);
		color: var(--color-accent-strong);
	}

	@media (max-width: 760px) {
		.header-inner {
			width: min(var(--content-width), calc(100% - 1.5rem));
			min-height: 4rem;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			display: block;
		}
	}
</style>
