---
import { GITHUB_PROFILE_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="header-inner" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}, home`}>
			<span class="brand-mark" aria-hidden="true">SM</span>
			<span class="brand-name">Stephen McCruden</span>
		</a>

		<div class="desktop-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a
				class="github-link"
				href={GITHUB_PROFILE_URL}
				target="_blank"
				rel="noreferrer"
			>
				GitHub
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" />
				</svg>
			</a>
		</div>

		<details class="mobile-menu">
			<summary aria-label="Open navigation">
				<span></span>
				<span></span>
				<span></span>
			</summary>
			<div class="mobile-panel">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/blog">Writing</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<a href={GITHUB_PROFILE_URL} target="_blank" rel="noreferrer">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</div>
		</details>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		z-index: 50;
		top: 0;
		border-bottom: 1px solid var(--color-border);
		background: rgba(11, 17, 23, 0.82);
		backdrop-filter: blur(18px);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(var(--content-width), calc(100% - 2rem));
		min-height: 4.5rem;
		margin-inline: auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--color-text);
		font-size: 0.96rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border: 1px solid var(--color-accent-border);
		border-radius: 0.6rem;
		background:
			linear-gradient(145deg, rgba(var(--color-accent-rgb), 0.18), transparent),
			var(--color-surface);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: -0.04em;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 1.8rem;
	}

	.github-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 0.65rem;
		color: var(--color-text);
		font-size: 0.86rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			border-color 160ms ease,
			background-color 160ms ease,
			transform 160ms ease;
	}

	.github-link:hover {
		border-color: var(--color-accent-border);
		background: var(--color-surface-raised);
		color: var(--color-accent);
		transform: translateY(-1px);
	}

	.github-link svg {
		width: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.mobile-menu {
		position: relative;
		display: none;
	}

	.mobile-menu summary {
		display: grid;
		width: 2.65rem;
		height: 2.65rem;
		cursor: pointer;
		list-style: none;
		place-content: center;
		gap: 0.28rem;
		border: 1px solid var(--color-border);
		border-radius: 0.7rem;
		background: var(--color-surface);
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu summary span {
		display: block;
		width: 1rem;
		height: 1px;
		background: var(--color-text);
		transition: transform 160ms ease;
	}

	.mobile-menu[open] summary span:first-child {
		transform: translateY(0.36rem) rotate(45deg);
	}

	.mobile-menu[open] summary span:nth-child(2) {
		opacity: 0;
	}

	.mobile-menu[open] summary span:last-child {
		transform: translateY(-0.36rem) rotate(-45deg);
	}

	.mobile-panel {
		position: absolute;
		top: calc(100% + 0.65rem);
		right: 0;
		display: grid;
		min-width: 13rem;
		padding: 0.6rem;
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
		background: var(--color-surface);
		box-shadow: var(--shadow-lg);
	}

	:global(.mobile-panel a) {
		padding: 0.75rem 0.85rem;
		border-radius: 0.55rem;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
	}

	:global(.mobile-panel a:hover),
	:global(.mobile-panel a.active) {
		background: var(--color-surface-raised);
		color: var(--color-accent);
	}

	@media (max-width: 760px) {
		.header-inner {
			min-height: 4rem;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			display: block;
		}
	}

	@media (max-width: 380px) {
		.brand-name {
			max-width: 8rem;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
	}
</style>
