---
import { GITHUB_PROFILE_URL } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-intro">
			<a class="footer-brand" href="/">Stephen McCruden</a>
			<p>
				Field engineer building practical experience in infrastructure,
				automation, Kubernetes, and reliability engineering.
			</p>
		</div>

		<nav aria-label="Footer navigation">
			<a href="/projects">Projects</a>
			<a href="/blog">Writing</a>
			<a href="/about">About</a>
			<a href={GITHUB_PROFILE_URL} target="_blank" rel="noreferrer">
				GitHub <span aria-hidden="true">↗</span>
			</a>
		</nav>
	</div>

	<div class="footer-meta">
		<p>&copy; {currentYear} Stephen McCruden</p>
		<p>Astro · Kubernetes · GitOps</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 1rem;
		border-top: 1px solid var(--color-border-strong);
		background: var(--color-surface);
	}

	.footer-inner,
	.footer-meta {
		width: min(var(--content-width), calc(100% - 2.5rem));
		margin-inline: auto;
	}

	.footer-inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 3rem;
		padding-block: 3.5rem;
	}

	.footer-intro {
		max-width: 34rem;
	}

	.footer-brand {
		color: var(--color-text);
		font-size: 1.08rem;
		font-weight: 700;
		text-decoration: none;
	}

	.footer-intro p {
		margin: 0.75rem 0 0;
		font-size: 0.95rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		justify-content: flex-end;
	}

	nav a {
		color: var(--color-text-muted);
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
	}

	nav a:hover {
		color: var(--color-accent-strong);
	}

	.footer-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.1rem;
		border-top: 1px solid var(--color-border);
	}

	.footer-meta p {
		margin: 0;
		color: var(--color-text-subtle);
		font-size: 0.8rem;
	}

	@media (max-width: 680px) {
		.footer-inner,
		.footer-meta {
			width: min(var(--content-width), calc(100% - 1.5rem));
		}

		.footer-inner,
		.footer-meta {
			align-items: flex-start;
			flex-direction: column;
		}

		nav {
			justify-content: flex-start;
		}
	}
</style>
