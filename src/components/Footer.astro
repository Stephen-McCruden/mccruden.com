---
const currentYear = new Date().getFullYear();
---

<footer>
	<p>&copy; {currentYear} Stephen McCruden.</p>
	<p>Built with Astro. Source and content live in Git.</p>

	<nav aria-label="Footer navigation">
		<a
			href="https://github.com/Stephen-McCruden"
			target="_blank"
			rel="noreferrer"
		>
			GitHub
		</a>
		<a href="/rss.xml">RSS</a>
	</nav>
</footer>

<style>
	footer {
		padding: 3rem 1rem;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}

	footer p {
		margin: 0.25rem 0;
	}

	nav {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1rem;
	}

	nav a {
		color: rgb(var(--gray-dark));
	}
</style>
