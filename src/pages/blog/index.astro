---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const description =
	'Engineering notes, build logs, incident reviews, and infrastructure lessons from Stephen McCruden.';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`Writing | ${SITE_TITLE}`} description={description}>
	<main id="main-content" class="page">
		<header class="page-hero">
			<div class="page-hero-copy">
				<p class="eyebrow">Technical writing</p>
				<h1>Notes from building, troubleshooting, and operating systems.</h1>
				<p class="lede">
					Project decisions, implementation details, incident reviews,
					and lessons from field engineering and a Kubernetes homelab.
				</p>
			</div>
			<aside class="page-hero-aside">
				<p>Published notes</p>
				<p>
					<strong>{posts.length.toString().padStart(2, '0')}</strong>
					{posts.length === 1 ? ' article' : ' articles'}
				</p>
			</aside>
		</header>

		<section class="section" aria-label="Published articles">
			{
				posts.length > 0 ? (
					<div class="article-list">
						{posts.map((post) => (
							<a class="article-row" href={`/blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>
									<FormattedDate date={post.data.pubDate} />
								</time>
								<div>
									<p class="project-kicker">
										{post.data.tags[0] ?? 'Engineering note'}
									</p>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</div>
								<span aria-hidden="true">→</span>
							</a>
						))}
					</div>
				) : (
					<div class="empty-state">
						<div>
							<h2>The first articles are being prepared.</h2>
							<p>
								The publishing system is ready. Upcoming notes
								will document the platform as it changes, including
								the decisions and failures behind the final result.
							</p>
						</div>
						<ul class="topic-list" aria-label="Planned writing topics">
							<li><span>01</span>Rebuilding Kubernetes from code</li>
							<li><span>02</span>Dependency-aware Flux design</li>
							<li><span>03</span>Failure testing and postmortems</li>
							<li><span>04</span>Useful observability</li>
						</ul>
					</div>
				)
			}
		</section>

		<section class="section split-section" aria-labelledby="approach-title">
			<div>
				<p class="eyebrow">Writing standard</p>
				<h2 id="approach-title">Enough context to understand the decision.</h2>
			</div>
			<div class="body-copy">
				<ul class="plain-list">
					<li>
						<strong>Context</strong>
						What the system needed to accomplish and which constraints mattered.
					</li>
					<li>
						<strong>Implementation</strong>
						The important configuration, commands, and architecture.
					</li>
					<li>
						<strong>Validation</strong>
						How the change was tested and what evidence proved it worked.
					</li>
					<li>
						<strong>Lessons</strong>
						What failed, what changed, and what I would do differently.
					</li>
				</ul>
			</div>
		</section>
	</main>
</BaseLayout>
