---
import {
	GITHUB_PROFILE_URL,
	HOMELAB_REPOSITORY_URL,
	SITE_TITLE,
} from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
	'About Stephen McCruden: field engineering, infrastructure automation, Kubernetes, observability, and reliable systems.';
---

<BaseLayout title={`About | ${SITE_TITLE}`} description={description}>
	<main id="main-content" class="page">
		<header class="page-hero">
			<div class="page-hero-copy">
				<p class="eyebrow">About me</p>
				<h1>Field experience backed by a serious infrastructure practice.</h1>
				<p class="lede">
					I’m Stephen McCruden, a field engineer in the Washington,
					D.C. region. I support important communications systems and
					build hands-on experience in platform engineering,
					automation, and site reliability through my homelab.
				</p>
			</div>
			<aside class="page-hero-aside">
				<p>Professional profile</p>
				<dl class="fact-list">
					<div>
						<dt>Role</dt>
						<dd>Field Engineer</dd>
					</div>
					<div>
						<dt>Domain</dt>
						<dd>Mission-critical communications</dd>
					</div>
					<div>
						<dt>Region</dt>
						<dd>Washington, D.C. area</dd>
					</div>
					<div>
						<dt>Certification</dt>
						<dd>CompTIA Network+</dd>
					</div>
				</dl>
			</aside>
		</header>

		<section class="section split-section" aria-labelledby="experience-title">
			<div>
				<p class="eyebrow">Professional experience</p>
				<h2 id="experience-title">Reliability is part technical work and part operating discipline.</h2>
			</div>
			<div class="body-copy">
				<p>
					My field work includes system upgrades, lab validation,
					troubleshooting, documentation, and coordination across
					technical teams and customer environments.
				</p>
				<p>
					Working around mission-critical systems has made preparation
					and verification non-negotiable: understand the dependencies,
					document the change, validate the result, and know how to
					recover if the expected path fails.
				</p>
				<ul class="plain-list">
					<li>
						<strong>Implementation and upgrades</strong>
						Plan and execute technical work against live operational constraints.
					</li>
					<li>
						<strong>Lab validation and troubleshooting</strong>
						Reproduce issues, test changes, and verify behavior before handoff.
					</li>
					<li>
						<strong>Documentation and coordination</strong>
						Make procedures understandable across teams and support repeatable execution.
					</li>
				</ul>
			</div>
		</section>

		<section class="section split-section" aria-labelledby="lab-title">
			<div>
				<p class="eyebrow">Engineering lab</p>
				<h2 id="lab-title">A place to practice the complete platform lifecycle.</h2>
			</div>
			<div class="body-copy">
				<p>
					My primary project is a three-node Kubernetes platform on
					Proxmox. It is designed for infrastructure engineering work:
					provisioning, configuration, hardening, application delivery,
					observability, and recovery.
				</p>
				<p>
					The environment is managed with Terraform, Ansible, and Flux.
					That gives me a repeatable place to study systems at the point
					where tools, processes, and operational tradeoffs meet.
				</p>
				<div class="button-row">
					<a
						class="button button-secondary"
						href={HOMELAB_REPOSITORY_URL}
						target="_blank"
						rel="noreferrer"
					>
						Explore the homelab <span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="strengths-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">What I bring</p>
					<h2 id="strengths-title">A bridge between operations and platform engineering.</h2>
				</div>
			</div>

			<div class="card-grid">
				<article class="card">
					<span class="card-number">01</span>
					<h3>Operational context</h3>
					<p>
						Experience working around systems where change planning,
						availability, and recovery have real consequences.
					</p>
				</article>
				<article class="card">
					<span class="card-number">02</span>
					<h3>Systems thinking</h3>
					<p>
						A habit of tracing dependencies across networking,
						compute, Linux, Kubernetes, and application delivery.
					</p>
				</article>
				<article class="card">
					<span class="card-number">03</span>
					<h3>Clear communication</h3>
					<p>
						Documentation and technical explanations written for
						people who need to execute and maintain the work.
					</p>
				</article>
			</div>
		</section>

		<section class="section split-section" aria-labelledby="toolkit-title">
			<div>
				<p class="eyebrow">Working toolkit</p>
				<h2 id="toolkit-title">Technologies I use and continue to deepen.</h2>
			</div>
			<dl class="stack-table">
				<div>
					<dt>Systems</dt>
					<dd>Linux · Proxmox · Networking · containerd</dd>
				</div>
				<div>
					<dt>Automation</dt>
					<dd>Terraform · Ansible · GitHub Actions · Python</dd>
				</div>
				<div>
					<dt>Platform</dt>
					<dd>Kubernetes · Cilium · Flux · Traefik</dd>
				</div>
				<div>
					<dt>Reliability</dt>
					<dd>Prometheus · Grafana · runbooks · failure testing</dd>
				</div>
				<div>
					<dt>Security</dt>
					<dd>SOPS · age · External Secrets · YubiKey</dd>
				</div>
			</dl>
		</section>

		<section class="cta">
			<div>
				<h2>Building toward platform, DevOps, and SRE roles.</h2>
				<p>
					I’m documenting the architecture, implementation, failures,
					and recoveries so the work can be evaluated on evidence.
				</p>
			</div>
			<div class="button-row">
				<a class="button button-primary" href="/projects">View my work</a>
				<a
					class="button button-secondary"
					href={GITHUB_PROFILE_URL}
					target="_blank"
					rel="noreferrer"
				>
					GitHub profile <span aria-hidden="true">↗</span>
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
