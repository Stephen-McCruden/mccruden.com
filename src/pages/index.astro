---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import {
	GITHUB_PROFILE_URL,
	HOMELAB_REPOSITORY_URL,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const latestPosts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout
	title={`${SITE_TITLE} | Infrastructure Engineer`}
	description={SITE_DESCRIPTION}
>
	<main id="main-content">
		<section class="hero container" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Infrastructure engineer · Washington, D.C. region</p>
				<h1 id="hero-title">
					I build reliable infrastructure and make it repeatable.
				</h1>
				<p class="hero-lede">
					I’m Stephen McCruden, a field engineer supporting
					mission-critical communications. My work and projects focus
					on Linux, infrastructure automation, Kubernetes, and the
					operational practices that keep systems understandable.
				</p>
				<div class="button-row">
					<a class="button button-primary" href="/projects">
						View selected work <span aria-hidden="true">→</span>
					</a>
					<a
						class="button button-secondary"
						href={GITHUB_PROFILE_URL}
						target="_blank"
						rel="noreferrer"
					>
						GitHub profile <span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>

			<aside class="hero-summary" aria-label="Professional summary">
				<p>At a glance</p>
				<dl class="fact-list">
					<div>
						<dt>Current role</dt>
						<dd>Field Engineer</dd>
					</div>
					<div>
						<dt>Professional domain</dt>
						<dd>Mission-critical communications</dd>
					</div>
					<div>
						<dt>Engineering focus</dt>
						<dd>Platform, DevOps, and SRE</dd>
					</div>
					<div>
						<dt>Core stack</dt>
						<dd>Linux · Terraform · Ansible · Kubernetes</dd>
					</div>
				</dl>
			</aside>
		</section>

		<section class="proof-bar" aria-label="Professional highlights">
			<ul class="proof-grid container">
				<li>
					<strong>Field engineering</strong>
					<span>Production operations experience</span>
				</li>
				<li>
					<strong>3-node platform</strong>
					<span>Proxmox and Kubernetes</span>
				</li>
				<li>
					<strong>End-to-end IaC</strong>
					<span>Terraform, Ansible, and Flux</span>
				</li>
				<li>
					<strong>CompTIA Network+</strong>
					<span>Networking foundation</span>
				</li>
			</ul>
		</section>

		<section class="section container" aria-labelledby="featured-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Featured project</p>
					<h2 id="featured-title">A homelab designed as an operating platform.</h2>
				</div>
				<a class="text-link" href="/projects">
					Project details <span aria-hidden="true">→</span>
				</a>
			</div>

			<article class="feature-project">
				<div>
					<p class="project-kicker">Reproducible Kubernetes homelab</p>
					<h3>Infrastructure that can be rebuilt, observed, and tested.</h3>
					<p class="project-summary">
						A three-node Proxmox environment that provisions virtual
						infrastructure with Terraform, configures Fedora nodes
						with Ansible, and continuously reconciles Kubernetes
						through Flux.
					</p>
					<ul class="tag-list" aria-label="Project technologies">
						<li class="tag">Proxmox</li>
						<li class="tag">Terraform</li>
						<li class="tag">Ansible</li>
						<li class="tag">Kubernetes</li>
						<li class="tag">Cilium</li>
						<li class="tag">Flux</li>
					</ul>
					<div class="button-row">
						<a
							class="button button-secondary"
							href={HOMELAB_REPOSITORY_URL}
							target="_blank"
							rel="noreferrer"
						>
							Inspect the repository <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<ol class="delivery-list" aria-label="Platform delivery path">
					<li>
						<span class="step">01</span>
						<div>
							<strong>Provision</strong>
							<span>Terraform defines Proxmox resources.</span>
						</div>
					</li>
					<li>
						<span class="step">02</span>
						<div>
							<strong>Configure</strong>
							<span>Ansible builds and hardens the nodes.</span>
						</div>
					</li>
					<li>
						<span class="step">03</span>
						<div>
							<strong>Reconcile</strong>
							<span>Flux applies the desired cluster state.</span>
						</div>
					</li>
					<li>
						<span class="step">04</span>
						<div>
							<strong>Operate</strong>
							<span>Prometheus and Grafana expose behavior.</span>
						</div>
					</li>
				</ol>
			</article>
		</section>

		<section class="section container" aria-labelledby="capabilities-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">What I work on</p>
					<h2 id="capabilities-title">Practical engineering across the system lifecycle.</h2>
				</div>
			</div>

			<div class="card-grid">
				<article class="card">
					<span class="card-number">01</span>
					<h3>Infrastructure automation</h3>
					<p>
						Repeatable provisioning, configuration management, and
						documented rebuild procedures.
					</p>
					<ul class="tag-list">
						<li class="tag">Terraform</li>
						<li class="tag">Ansible</li>
						<li class="tag">Python</li>
					</ul>
				</article>
				<article class="card">
					<span class="card-number">02</span>
					<h3>Kubernetes operations</h3>
					<p>
						Cluster networking, GitOps delivery, secrets, ingress,
						and workload reliability.
					</p>
					<ul class="tag-list">
						<li class="tag">Kubernetes</li>
						<li class="tag">Cilium</li>
						<li class="tag">Flux</li>
					</ul>
				</article>
				<article class="card">
					<span class="card-number">03</span>
					<h3>Reliability and observability</h3>
					<p>
						Metrics, dashboards, health checks, recovery testing,
						and operational documentation.
					</p>
					<ul class="tag-list">
						<li class="tag">Prometheus</li>
						<li class="tag">Grafana</li>
						<li class="tag">Runbooks</li>
					</ul>
				</article>
			</div>
		</section>

		<section class="section container" aria-labelledby="writing-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Technical writing</p>
					<h2 id="writing-title">Notes from building and operating systems.</h2>
					<p>
						Project decisions, implementation details, troubleshooting,
						and lessons worth carrying into the next build.
					</p>
				</div>
				<a class="text-link" href="/blog">
					All writing <span aria-hidden="true">→</span>
				</a>
			</div>

			{
				latestPosts.length > 0 ? (
					<div class="writing-list">
						{latestPosts.map((post) => (
							<a class="writing-row" href={`/blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>
									<FormattedDate date={post.data.pubDate} />
								</time>
								<div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
								<span aria-hidden="true">→</span>
							</a>
						))}
					</div>
				) : (
					<div class="empty-state">
						<div>
							<h2>First articles in progress.</h2>
							<p>
								The writing section is ready for project notes,
								runbooks, and postmortems as the platform evolves.
							</p>
						</div>
						<ul class="topic-list" aria-label="Planned writing topics">
							<li><span>01</span>Kubernetes rebuilds</li>
							<li><span>02</span>Flux dependency design</li>
							<li><span>03</span>Failure testing and recovery</li>
							<li><span>04</span>Observability decisions</li>
						</ul>
					</div>
				)
			}
		</section>

		<section class="cta container">
			<div>
				<h2>Looking for the details behind the project?</h2>
				<p>
					The repository shows the implementation. The About page
					explains the field experience and engineering approach behind it.
				</p>
			</div>
			<div class="button-row">
				<a class="button button-primary" href="/about">About me</a>
				<a class="button button-secondary" href="/projects">View projects</a>
			</div>
		</section>
	</main>
</BaseLayout>
