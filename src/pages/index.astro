---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import {
	HOMELAB_REPOSITORY_URL,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const latestPosts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout
	title={`${SITE_TITLE} | Infrastructure & Reliability Engineering`}
	description={SITE_DESCRIPTION}
>
	<main id="main-content">
		<section class="hero container" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Field engineer · Infrastructure · Reliability</p>

				<h1 id="hero-title">
					Reliable infrastructure,
					<span>built to be understood.</span>
				</h1>

				<p class="hero-lede">
					I’m Stephen McCruden, a field engineer working with
					mission-critical public-safety communications. I design,
					automate, and document systems with a focus on Kubernetes,
					GitOps, and operational clarity.
				</p>

				<div class="hero-actions">
					<a class="button button-primary" href="/projects">
						Explore my work
						<span aria-hidden="true">→</span>
					</a>
					<a class="button button-secondary" href="/blog">
						Read the engineering notes
					</a>
				</div>

				<ul class="hero-disciplines" aria-label="Areas of focus">
					<li>Kubernetes</li>
					<li>Infrastructure as code</li>
					<li>GitOps</li>
					<li>Observability</li>
				</ul>
			</div>

			<aside class="focus-panel surface" aria-label="Current engineering focus">
				<p class="focus-label">Current focus</p>
				<h2>Production-minded infrastructure in a hands-on homelab.</h2>
				<p>
					A reproducible platform for testing automation, failure
					recovery, observability, and GitOps workflows.
				</p>
				<dl>
					<div>
						<dt>Platform</dt>
						<dd>Kubernetes on Proxmox</dd>
					</div>
					<div>
						<dt>Delivery</dt>
						<dd>Terraform · Ansible · Flux</dd>
					</div>
					<div>
						<dt>Operations</dt>
						<dd>Prometheus · Grafana</dd>
					</div>
				</dl>
				<a class="text-link" href="/projects">
					View the complete platform <span aria-hidden="true">→</span>
				</a>
			</aside>
		</section>

		<section class="capability-strip" aria-label="Technical disciplines">
			<div class="container">
				<p>Linux</p>
				<span aria-hidden="true"></span>
				<p>Terraform</p>
				<span aria-hidden="true"></span>
				<p>Ansible</p>
				<span aria-hidden="true"></span>
				<p>Kubernetes</p>
				<span aria-hidden="true"></span>
				<p>Flux</p>
				<span aria-hidden="true"></span>
				<p>Prometheus</p>
			</div>
		</section>

		<section class="featured-section container" aria-labelledby="featured-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Featured engineering project</p>
					<h2 id="featured-title">A homelab built like a production platform.</h2>
				</div>
				<a class="text-link" href="/projects">
					All project details <span aria-hidden="true">→</span>
				</a>
			</div>

			<article class="project-card surface">
				<div class="project-copy">
					<div class="project-meta">
						<span>Active project</span>
						<span>Infrastructure platform</span>
					</div>
					<h3>Reproducible Kubernetes Homelab</h3>
					<p>
						A three-node environment designed to be destroyed,
						reconstructed, observed, and failure-tested—not merely
						kept running.
					</p>

					<div class="project-metrics" aria-label="Project highlights">
						<div>
							<strong>3</strong>
							<span>physical nodes</span>
						</div>
						<div>
							<strong>100%</strong>
							<span>Git-managed platform</span>
						</div>
						<div>
							<strong>IaC</strong>
							<span>rebuild workflow</span>
						</div>
					</div>

					<ul class="tag-list" aria-label="Project technologies">
						<li class="tag">Proxmox</li>
						<li class="tag">Terraform</li>
						<li class="tag">Ansible</li>
						<li class="tag">Kubernetes</li>
						<li class="tag">Cilium</li>
						<li class="tag">Flux</li>
					</ul>

					<a
						class="button button-secondary"
						href={HOMELAB_REPOSITORY_URL}
						target="_blank"
						rel="noreferrer"
					>
						Inspect the repository
						<span aria-hidden="true">↗</span>
					</a>
				</div>

				<div class="architecture" aria-label="Platform delivery flow">
					<div class="architecture-label">
						<span>Delivery path</span>
						<span>declarative</span>
					</div>

					<ol>
						<li>
							<span class="step-number">01</span>
							<div>
								<strong>Provision</strong>
								<small>Terraform · Proxmox</small>
							</div>
							<span class="step-state">defined</span>
						</li>
						<li>
							<span class="step-number">02</span>
							<div>
								<strong>Configure</strong>
								<small>Ansible · Fedora</small>
							</div>
							<span class="step-state">idempotent</span>
						</li>
						<li>
							<span class="step-number">03</span>
							<div>
								<strong>Reconcile</strong>
								<small>Flux · Kubernetes</small>
							</div>
							<span class="step-state">continuous</span>
						</li>
						<li>
							<span class="step-number">04</span>
							<div>
								<strong>Observe</strong>
								<small>Prometheus · Grafana</small>
							</div>
							<span class="step-state">visible</span>
						</li>
					</ol>
				</div>
			</article>
		</section>

		<section class="principles-section container" aria-labelledby="principles-title">
			<div class="section-heading compact">
				<div>
					<p class="eyebrow">Engineering approach</p>
					<h2 id="principles-title">Reliability is a design constraint.</h2>
				</div>
			</div>

			<div class="principle-grid">
				<article class="surface">
					<span class="principle-number">01</span>
					<h3>Make it reproducible</h3>
					<p>
						A recovery plan is incomplete until the system can be
						reconstructed predictably from documented code.
					</p>
				</article>
				<article class="surface">
					<span class="principle-number">02</span>
					<h3>Make behavior visible</h3>
					<p>
						Metrics, logs, and meaningful health signals turn
						guesswork into informed operational decisions.
					</p>
				</article>
				<article class="surface">
					<span class="principle-number">03</span>
					<h3>Test the failure path</h3>
					<p>
						Backups, automation, and high availability only become
						trustworthy after deliberate failure testing.
					</p>
				</article>
			</div>
		</section>

		<section class="writing-section container" aria-labelledby="writing-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">From the notebook</p>
					<h2 id="writing-title">Engineering notes and field lessons.</h2>
				</div>
				<a class="text-link" href="/blog">
					Browse all writing <span aria-hidden="true">→</span>
				</a>
			</div>

			{
				latestPosts.length > 0 ? (
					<div class="post-grid">
						{latestPosts.map((post) => (
							<article class="post-card surface">
								<div>
									<p class="post-kicker">{post.data.tags?.[0] ?? 'Engineering note'}</p>
									<h3>
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>
									<p>{post.data.description}</p>
								</div>
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									<span aria-hidden="true">→</span>
								</div>
							</article>
						))}
					</div>
				) : (
					<div class="writing-empty surface">
						<div>
							<p class="empty-label">First articles in progress</p>
							<h3>The useful details—not just the finished screenshot.</h3>
							<p>
								Upcoming posts will cover Kubernetes rebuilds,
								incident analysis, infrastructure decisions, and the
								operational lessons behind the platform.
							</p>
						</div>
						<ul class="tag-list" aria-label="Planned writing topics">
							<li class="tag">Build logs</li>
							<li class="tag">Postmortems</li>
							<li class="tag">Architecture</li>
							<li class="tag">Runbooks</li>
						</ul>
					</div>
				)
			}
		</section>

		<section class="closing-cta container">
			<div class="cta-panel surface">
				<div>
					<p class="eyebrow">See how I work</p>
					<h2>Systems are more credible when the decisions are visible.</h2>
				</div>
				<div class="cta-actions">
					<a class="button button-primary" href="/about">More about me</a>
					<a
						class="button button-secondary"
						href={HOMELAB_REPOSITORY_URL}
						target="_blank"
						rel="noreferrer"
					>
						Open the homelab
						<span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
		min-height: min(48rem, calc(100vh - 4.5rem));
		padding-block: clamp(5rem, 10vw, 8rem);
	}

	.hero-copy {
		position: relative;
		min-width: 0;
	}

	.hero h1 {
		max-width: 11ch;
		margin-top: 1.25rem;
		font-size: clamp(3.25rem, 6vw, 5.1rem);
	}

	.hero h1 span {
		display: block;
		background: linear-gradient(
			100deg,
			var(--color-text) 5%,
			var(--color-accent-strong) 92%
		);
		background-clip: text;
		color: transparent;
	}

	.hero-lede {
		max-width: 42rem;
		margin-top: 1.75rem;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.hero-disciplines {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 2.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.hero-disciplines li {
		position: relative;
		padding-left: 0.8rem;
		color: var(--color-text-subtle);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.hero-disciplines li::before {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.25rem;
		height: 0.25rem;
		border-radius: 999px;
		background: var(--color-accent);
		content: "";
		transform: translateY(-50%);
	}

	.focus-panel {
		min-width: 0;
		padding: clamp(1.5rem, 3vw, 2rem);
		box-shadow: var(--shadow-md);
	}

	.focus-label {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.focus-panel h2 {
		font-size: clamp(1.65rem, 3vw, 2.25rem);
		line-height: 1.15;
	}

	.focus-panel > p:not(.focus-label) {
		margin: 1rem 0 1.5rem;
		font-size: 1rem;
	}

	.focus-panel dl {
		margin: 0 0 1.5rem;
		border-block: 1px solid var(--color-border);
	}

	.focus-panel dl div {
		display: grid;
		grid-template-columns: minmax(6rem, 0.7fr) minmax(0, 1.3fr);
		gap: 1rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.focus-panel dl div:last-child {
		border-bottom: 0;
	}

	.focus-panel dt,
	.focus-panel dd {
		margin: 0;
		font-size: 0.88rem;
	}

	.focus-panel dt {
		color: var(--color-text-subtle);
	}

	.focus-panel dd {
		color: var(--color-text);
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.capability-strip {
		border-block: 1px solid var(--color-border);
		background: rgba(8, 13, 18, 0.46);
	}

	.capability-strip .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4.7rem;
	}

	.capability-strip p {
		margin: 0;
		color: var(--color-text-subtle);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.capability-strip span {
		width: 0.25rem;
		height: 0.25rem;
		border-radius: 999px;
		background: var(--color-border-strong);
	}

	.featured-section,
	.principles-section,
	.writing-section {
		padding-top: clamp(5rem, 10vw, 8rem);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.section-heading h2 {
		max-width: 16ch;
		margin-top: 0.9rem;
	}

	.section-heading.compact h2 {
		max-width: 19ch;
	}

	.project-card {
		display: grid;
		grid-template-columns: minmax(0, 1.06fr) minmax(20rem, 0.94fr);
		gap: 2.5rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
	}

	.project-copy {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		min-width: 0;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 1.6rem;
	}

	.project-meta span {
		padding: 0.28rem 0.55rem;
		border-radius: 999px;
		background: var(--color-accent-soft);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.project-meta span:last-child {
		background: rgba(148, 166, 184, 0.08);
		color: var(--color-text-subtle);
	}

	.project-copy h3 {
		font-size: clamp(1.7rem, 3vw, 2.35rem);
	}

	.project-copy > p {
		max-width: 36rem;
		margin-top: 1rem;
	}

	.project-metrics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		width: 100%;
		margin: 1.4rem 0;
		border-block: 1px solid var(--color-border);
	}

	.project-metrics div {
		padding: 1rem 0.8rem;
		border-right: 1px solid var(--color-border);
	}

	.project-metrics div:first-child {
		padding-left: 0;
	}

	.project-metrics div:last-child {
		border-right: 0;
	}

	.project-metrics strong,
	.project-metrics span {
		display: block;
	}

	.project-metrics strong {
		color: var(--color-accent-strong);
		font-family: var(--font-mono);
		font-size: 1.1rem;
	}

	.project-metrics span {
		margin-top: 0.2rem;
		color: var(--color-text-subtle);
		font-size: 0.78rem;
	}

	.project-copy .button {
		margin-top: 1.6rem;
	}

	.architecture {
		align-self: stretch;
		min-width: 0;
		padding: 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background:
			linear-gradient(rgba(45, 212, 191, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(45, 212, 191, 0.025) 1px, transparent 1px),
			rgba(8, 13, 18, 0.56);
		background-size: 24px 24px;
	}

	.architecture-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.2rem 0.3rem 1rem;
		color: var(--color-text-subtle);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.architecture-label span:last-child {
		color: var(--color-accent);
	}

	.architecture ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.architecture li {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.8rem;
		padding: 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: rgba(17, 27, 36, 0.88);
	}

	.architecture li:not(:last-child)::after {
		position: absolute;
		z-index: 2;
		bottom: -0.8rem;
		left: 1.58rem;
		width: 1px;
		height: 0.8rem;
		background: var(--color-accent-border);
		content: "";
	}

	.step-number {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.architecture strong,
	.architecture small {
		display: block;
	}

	.architecture strong {
		font-size: 0.92rem;
	}

	.architecture small {
		margin-top: 0.15rem;
		color: var(--color-text-subtle);
		font-size: 0.78rem;
	}

	.step-state {
		color: var(--color-text-subtle);
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}

	.principle-grid,
	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.principle-grid article {
		display: flex;
		flex-direction: column;
		min-height: 14rem;
		padding: 1.5rem;
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.principle-grid article:hover {
		border-color: var(--color-accent-border);
		transform: translateY(-3px);
	}

	.principle-number {
		display: block;
		margin-bottom: 2.5rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.principle-grid h3 {
		margin-bottom: 0.7rem;
	}

	.principle-grid p {
		margin: 0;
		font-size: 1rem;
	}

	.post-card {
		display: flex;
		justify-content: space-between;
		flex-direction: column;
		min-height: 18rem;
		padding: 1.5rem;
	}

	.post-kicker,
	.empty-label {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.post-card h3 a {
		color: var(--color-text);
		text-decoration: none;
	}

	.post-card h3 a:hover {
		color: var(--color-accent-strong);
	}

	.post-card h3 + p {
		margin-top: 0.8rem;
		font-size: 1rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
		color: var(--color-text-subtle);
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.post-meta span {
		color: var(--color-accent);
	}

	.writing-empty {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 3rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
	}

	.writing-empty > div {
		max-width: 42rem;
	}

	.writing-empty h3 {
		font-size: clamp(1.5rem, 3vw, 2rem);
	}

	.writing-empty h3 + p {
		margin: 1rem 0 0;
	}

	.writing-empty .tag-list {
		justify-content: flex-end;
		max-width: 17rem;
	}

	.closing-cta {
		padding-top: clamp(5rem, 10vw, 8rem);
	}

	.cta-panel {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
		padding: clamp(2rem, 5vw, 3.5rem);
		overflow: hidden;
	}

	.cta-panel::after {
		position: absolute;
		right: -8rem;
		bottom: -11rem;
		width: 24rem;
		height: 24rem;
		border-radius: 999px;
		background: rgba(45, 212, 191, 0.08);
		filter: blur(3rem);
		content: "";
		pointer-events: none;
	}

	.cta-panel > div {
		position: relative;
		z-index: 1;
	}

	.cta-panel h2 {
		max-width: 18ch;
		margin-top: 0.9rem;
		font-size: clamp(1.8rem, 4vw, 2.8rem);
	}

	.cta-actions {
		display: flex;
		flex: 0 0 auto;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	@media (max-width: 960px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.hero-copy {
			max-width: 50rem;
		}

		.focus-panel {
