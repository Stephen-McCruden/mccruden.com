---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">Field Engineer · Infrastructure · Kubernetes</p>

				<h1>I build infrastructure that can be understood, rebuilt, and trusted.</h1>

				<p class="lede">
					I’m Stephen McCruden, a field engineer working with mission-critical
					public-safety communications. Here I document the automation, failure
					testing, and operational lessons behind my homelab.
				</p>

				<div class="actions">
					<a class="button primary" href="/blog">Read the blog</a>

					<a
						class="button secondary"
						href="https://github.com/Stephen-McCruden/homelab"
						target="_blank"
						rel="noreferrer"
					>
						Explore the homelab
						<span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<section aria-labelledby="featured-project">
				<p class="section-label">Featured project</p>
				<h2 id="featured-project">Reproducible Kubernetes homelab</h2>

				<p>
					A three-node platform built to be destroyed, reconstructed, observed,
					and failure-tested—not merely kept running.
				</p>

				<ul>
					<li>Terraform provisions Fedora virtual machines on Proxmox.</li>
					<li>Ansible configures and hardens every Kubernetes node.</li>
					<li>Flux reconciles cluster services and configuration from Git.</li>
					<li>Prometheus and Grafana provide metrics and operational visibility.</li>
					<li>A complete rebuild succeeds without undocumented manual intervention.</li>
				</ul>

				<a
					href="https://github.com/Stephen-McCruden/homelab"
					target="_blank"
					rel="noreferrer"
				>
					View the project on GitHub
					<span aria-hidden="true">↗</span>
				</a>
			</section>

			<section class="details" aria-label="Current work and writing">
				<article>
					<h2>Current focus</h2>
					<p>
						Expanding the platform with persistent storage, centralized logging,
						disaster-recovery testing, and stateless applications—all managed
						through infrastructure as code.
					</p>
				</article>

				<article>
					<h2>What I write about</h2>
					<p>
						Kubernetes, Linux, Terraform, Ansible, GitOps, observability,
						self-hosting, troubleshooting, and the engineering decisions behind
						the finished system.
					</p>

					<a href="/blog">Browse the writing →</a>
				</article>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 4rem;
	}

	.eyebrow,
	.section-label {
		margin-bottom: 0.75rem;
		color: var(--accent-dark);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 18ch;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		letter-spacing: -0.04em;
	}

	.lede {
		max-width: 62ch;
		font-size: 1.15rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-block;
		padding: 0.65rem 1rem;
		border: 2px solid var(--accent);
		border-radius: 6px;
		font-weight: 700;
		text-decoration: none;
	}

	.primary {
		background: var(--accent);
		color: white;
	}

	.primary:hover {
		background: var(--accent-dark);
		color: white;
	}

	.secondary {
		background: white;
	}

	main > section:not(:first-child) {
		padding: 3rem 0;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.details {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	.details h2 {
		font-size: 1.75rem;
	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 1rem;
		}

		.details {
			grid-template-columns: 1fr;
		}
	}
</style>
